{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "miniblink-app",
  "version": "0.1.0",
  "identifier": "ai.codebuddy.miniblink.app",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Miniblink + Tauri",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
